# Copy this to .env locally (never commit the real .env), or set these as
# environment variables on your Render backend service dashboard.

# Required for the AI Assistant (/chat endpoint) to work.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini if not set.
OPENAI_CHAT_MODEL=gpt-4o-mini
