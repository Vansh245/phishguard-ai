# Copy this to .env locally (never commit the real .env), or set these as
# environment variables on your Render backend service dashboard.

# Required for the AI Assistant (/chat endpoint) to work.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini if not set.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL(s)). Defaults to localhost dev origins only if unset.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Required to call POST /fingerprint/register (send as the X-Admin-Key
# header). Leave unset to disable brand registration entirely.
ADMIN_API_KEY=
